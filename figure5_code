# 21. STUDENT-T CONFIDENCE INTERVAL
# ============================================================

def mean_t_ci(
    values,
    confidence=CI_CONFIDENCE
):
    """
    Calculate a two-sided Student-t confidence interval
    for the mean of independent Monte Carlo estimates.

    The interval is:

      mean +/- t_critical * standard_error

    The sample standard deviation uses ddof=1.

    This interval summarizes variation across
    independent simulation repetitions.
    """

    values = np.asarray(values, dtype=float)

    n = len(values)

    if n < 2:
        raise ValueError(
            "At least two independent runs are required."
        )

    # Sample mean.
    mean = np.mean(values)

    # Standard error of the sample mean.
    standard_error = (
        np.std(values, ddof=1)
        / np.sqrt(n)
    )

    # Student-t critical value.
    critical = student_t.ppf(
        (1 + confidence) / 2,
        df=n - 1
    )

    # Confidence interval half-width.
    margin = critical * standard_error

    return (
        mean,
        mean - margin,
        mean + margin
    )


