# 22. CONFIDENCE INTERVAL EXPERIMENT
# ============================================================

def run_ci_analysis():
    """
    Evaluate MI variability across independent
    Monte Carlo simulation repetitions.

    The comparison is performed at 20 dB using
    20 independent runs.

    Each run produces:
      - Proposed SBF MI
      - Liu-inspired benchmark MI
      - Paired MI difference (SBF - Liu)

    Student-t confidence intervals are calculated
    across the independent run-level estimates.

    Results are printed and saved to CSV.
    """

    records = np.empty((CI_REPEATS, 3))

    print("\n" + "=" * 85)

    print(
        f"{CI_CONFIDENCE:.0%} CONFIDENCE INTERVALS "
        f"AT {CI_SNR_DB} dB"
    )

    print(
        f"Independent runs: {CI_REPEATS}; "
        f"blocks per run: {num_samples}"
    )

    print("=" * 85)

    # --------------------------------------------------------
    # INDEPENDENT MONTE CARLO REPETITIONS
    # --------------------------------------------------------

    for i in range(CI_REPEATS):

        # Independent RNG for the original methods.
        rng = np.random.default_rng(
            SEED + (i + 1) * CI_SEED_STEP
        )

        # Independent RNG for the Liu benchmark.
        liu_rng = np.random.default_rng(
            LIU_SEED + (i + 1) * CI_SEED_STEP
        )

        # Simulate all methods at the selected SNR.
        result = simulate_one_snr(
            CI_SNR_DB,
            rng,
            liu_rng,
            show_progress=False
        )

        mi_sbf = float(result[1])
        mi_liu = float(result[5])

        # Store paired run-level results.
        records[i] = (
            mi_sbf,
            mi_liu,
            mi_sbf - mi_liu
        )

        print(
            f"Run {i + 1:02d}/{CI_REPEATS} | "
            f"SBF={mi_sbf:.5f} | "
            f"Liu={mi_liu:.5f} | "
            f"Difference={mi_sbf-mi_liu:+.5f}",
            flush=True
        )

    # --------------------------------------------------------
    # CALCULATE CONFIDENCE INTERVALS
    # --------------------------------------------------------

    print("\nFINAL 95% CONFIDENCE INTERVAL RESULTS")

    comparisons = [

        (
            "Proposed SBF MI",
            records[:, 0]
        ),

        (
            "Liu adapted MI",
            records[:, 1]
        ),

        (
            "Paired MI difference (SBF - Liu)",
            records[:, 2]
        )
    ]

    for name, values in comparisons:

        mean, lower, upper = mean_t_ci(values)

        print(
            f"{name:33s} | "
            f"Mean={mean:.5f} bits | "
            f"95% CI=[{lower:.5f}, {upper:.5f}]"
        )

    # --------------------------------------------------------
    # SAVE CONFIDENCE INTERVAL DATA
    # --------------------------------------------------------

    csv_path = os.path.abspath(
        os.path.join(
            OUTPUT_DIR,
            "figure5_liu_ci_20db.csv"
        )
    )

    np.savetxt(
        csv_path,
        records,
        delimiter=",",
        comments="",
        header=(
            "MI_SBF_bits,"
            "MI_Liu_CPAdapted_bits,"
            "Paired_Difference_bits"
        )
    )

    print("Saved CI results:", csv_path)

    # --------------------------------------------------------
    # INTERPRET THE PAIRED CONFIDENCE INTERVAL
    # --------------------------------------------------------

    _, lower, upper = mean_t_ci(
        records[:, 2]
    )

    if lower > 0:

        print(
            "Paired CI is above zero: "
            "detectable SBF MI advantage at 20 dB."
        )

    elif upper < 0:

        print(
            "Paired CI is below zero: "
            "detectable Liu MI advantage at 20 dB."
        )

    else:

        print(
            "Paired CI includes zero: "
            "difference not distinguishable at 95%."
        )


