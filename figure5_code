# ============================================================
# 4. CHANNEL GENERATION
# ============================================================

def generate_channel_taps(L, rng):
    """
    Generate an L-tap complex Rayleigh fading channel.

    An exponentially decaying power-delay profile
    with 3 dB reduction per tap is used.

    The total average power across all taps is
    normalized to unity.
    """

    r = 10 ** (-3.0 / 10.0)

    # Exponential power-delay profile.
    power = r ** np.arange(L)
    power /= power.sum()

    # Circularly symmetric complex Gaussian taps.
    return np.sqrt(power / 2) * (
        rng.standard_normal(L)
        + 1j * rng.standard_normal(L)
    )


def link_amp(distance):
    """
    Distance-dependent channel amplitude.

    The amplitude follows d^(-ETA/2), corresponding
    to received power proportional to d^(-ETA).
    """

    return distance ** (-ETA / 2)


def dominant_tap_channel(L, distance, rng):
    """
    Generate the effective scalar channel from the
    first fading tap and apply distance-based path loss.
    """

    return (
        generate_channel_taps(L, rng)[0]
        * link_amp(distance)
    )


def dominant_tap_variance(L, distance):
    """
    Analytical variance of the first fading tap.

    Used to calculate the reference backscatter power
    for consistent noise normalization.
    """

    r = 10 ** (-3.0 / 10.0)

    return (
        link_amp(distance) ** 2
        / np.sum(r ** np.arange(L))
    )


# ============================================================
# 5. NOISE POWER NORMALIZATION
# ============================================================

# Reference power of the no-IRS backscatter link.
#
# It depends on:
# - Ambient source transmit power
# - Backscatter reflection coefficient
# - Source-to-T2 channel variance
# - Direct inter-tag channel variance
#
# The same reference is used for all schemes.

baseline_power = (
    p * abs(beta) ** 2
    * dominant_tap_variance(TAU_S2, D_S2)
    * dominant_tap_variance(TAU_12, D_12)
)


def noise_std(snr_db):
    """
    Convert SNR in dB into complex-noise standard
    deviation using the fixed reference power.
    """

    return np.sqrt(
        baseline_power * 10 ** (-snr_db / 10)
    )


# ============================================================
# 6. OFDM AND BACKSCATTER SIGNAL GENERATION
# ============================================================

def ofdm_symbol(rng):
    """
    Generate a QPSK OFDM symbol with cyclic prefix.

    The IFFT is scaled by sqrt(N) to maintain
    the intended time-domain power normalization.
    """

    # Random QPSK frequency-domain symbols.
    data = rng.choice(
        np.array([
            1 + 1j,
            1 - 1j,
            -1 + 1j,
            -1 - 1j
        ]),
        N
    ) / np.sqrt(2)

    # Convert to time domain.
    x = np.fft.ifft(data) * np.sqrt(N)

    # Prepend the cyclic prefix.
    return np.concatenate((x[-Ncp:], x))


def backscatter_waveform():
    """
    Generate the bipolar backscatter modulation sequence.

    The second half of the OFDM waveform is multiplied
    by -1, enabling the CP-based observation operation.
    """

    b = np.ones(Nt, dtype=complex)
    b[Nt // 2:] = -1

    return b


# Fixed modulation sequence used in all schemes.
B = backscatter_waveform()

# CP indices after excluding the initial samples
# according to the assumed maximum channel delay.
CP_INDICES = np.arange(L_max - 1, Ncp)


def complex_noise(sigma_n, rng):
    """
    Generate circularly symmetric complex AWGN.

    Real and imaginary components each contribute
    half of the total complex-noise variance.
    """

    return sigma_n * (
        rng.standard_normal(Nt)
        + 1j * rng.standard_normal(Nt)
    ) / np.sqrt(2)


# ============================================================
# 7. TRIANGLE-CHANNEL AND RSS EXTRACTION
# ============================================================

def extract_triangle_channel(y):
    """
    Extract the noncoherent triangle-channel statistic.

    The cyclic prefix is compared with corresponding
    OFDM samples separated by N positions.

    The metric is the average magnitude of the product
    of the difference and sum observations.

    No explicit instantaneous CSI is required.
    """

    zb = y[CP_INDICES] - y[CP_INDICES + N]
    zd = y[CP_INDICES] + y[CP_INDICES + N]

    return np.mean(np.abs(zb * zd))


def extract_rss(y):
    """
    Extract an RSS-like backscatter observation.

    The difference between CP-related samples
    suppresses their common component under the
    idealized signal model.

    The squared magnitude is averaged to obtain
    the received-power-based statistic.
    """

    zb = y[CP_INDICES] - y[CP_INDICES + N]

    return np.mean(np.abs(zb) ** 2)


# ============================================================
# 8. COMPOSITE IRS CHANNEL
# ============================================================

def composite_channel(g12, g1I, gI2, phi):
    """
    Calculate the effective inter-tag channel.

    G12 = g12 + sum_m(g1I[m] * exp(j*phi[m]) * gI2[m])

    The composite channel includes both the direct
    inter-tag path and the IRS-reflected contribution.

    No 1/sqrt(M) normalization is applied.
    """

    return (
        g12
        + np.sum(
            g1I * np.exp(1j * phi) * gI2
        )
    )


# ============================================================
# 9. PERFECT-CSI IRS PHASE ALIGNMENT
# ============================================================

def perfect_alignment_channel(g12, g1I, gI2):
    """
    Calculate the ideal IRS-assisted channel using
    perfect instantaneous CSI.

    The IRS phase of each reflected component is
    selected to align it with the direct channel.

    This maximizes the composite channel magnitude
    under the assumed continuous-phase model.

    Unlike SBF, this reference requires knowledge
    of the complex channel coefficients.
    """

    # Cascaded channel contribution of each IRS element.
    reflected = g1I * gI2

    # Align each reflected contribution with the
    # phase of the direct inter-tag channel.
    phi_opt = (
        np.angle(g12)
        - np.angle(reflected)
    ) % (2 * np.pi)

    return composite_channel(
        g12, g1I, gI2, phi_opt
    )


# ============================================================
# 10. NOISY SBF FEEDBACK OBSERVATION
# ============================================================

def feedback_observation(
    G12, g1, g2, pilot, sigma_n, rng
):
    """
    Generate a noisy CP-based triangle-channel
    measurement at the coordinating tag T1.

    The received signal includes:
    - Direct ambient RF signal
    - Backscattered signal through G12
    - Complex Gaussian receiver noise

    A fresh noise realization is generated for
    every candidate IRS phase configuration.
    """

    y = (
        pilot * g1
        + beta * pilot * g2 * B * G12
        + complex_noise(sigma_n, rng)
    )

    return extract_triangle_channel(y)


# ============================================================
# 11. MEASUREMENT-BASED ONE-BIT SBF
# ============================================================

def sbf_algorithm(
    g12, g1I, gI2, g1, g2, sigma_n, rng
):
    """
    Perform one-bit stochastic beamforming.

    The algorithm optimizes IRS phases using noisy
    triangle-channel measurements rather than CSI.

    For each iteration:
    1. Perturb the currently accepted IRS phases.
    2. Measure the new triangle-channel statistic.
    3. Compare the candidate with the stored metric.
    4. Accept or reject the candidate configuration.

    One logical binary feedback decision is required
    per perturbation iteration.

    The physical passive-backscatter feedback link,
    feedback reception errors, and tag energy
    consumption are not explicitly simulated here.

    Returns:
        G_best   : selected composite channel
        accepted : number of accepted updates
    """

    # Generate a fixed pilot for this SBF optimization.
    pilot = ofdm_symbol(rng)

    # Random initial IRS phase configuration.
    phi_best = rng.uniform(
        0, 2 * np.pi, M
    )

    # Initial composite channel.
    G_best = composite_channel(
        g12, g1I, gI2, phi_best
    )

    # Initial noisy feedback metric.
    metric_best = feedback_observation(
        G_best, g1, g2,
        pilot, sigma_n, rng
    )

    accepted = 0

    # Sequential one-bit SBF iterations.
    for _ in range(SBF_iterations):

        # Perturb each IRS element independently.
        phi_new = phi_best + rng.uniform(
            -delta, delta, M
        )

        # Composite channel under candidate phases.
        G_new = composite_channel(
            g12, g1I, gI2, phi_new
        )

        # Evaluate the candidate using noisy CP feedback.
        metric_new = feedback_observation(
            G_new, g1, g2,
            pilot, sigma_n, rng
        )

        # One-bit decision:
        # b(k)=1 if the candidate observation improves.
        # b(k)=0 otherwise.
        #
        # The ideal feedback decision is implemented
        # directly by the following conditional statement.
        if metric_new > metric_best:

            # Accept the candidate phase configuration.
            phi_best = phi_new
            G_best = G_new
            metric_best = metric_new

            accepted += 1

    # For 30 iterations, 30 sequential logical feedback
    # decisions are generated. Physical transmission
    # through passive backscatter is not modeled.

    return G_best, accepted


# ============================================================
# 12. LIU-INSPIRED RANDOM IRS PHASE GENERATION
# ============================================================

def liu_random_phases(rng):
    """
    Generate random IRS phase configurations for
    the Liu-inspired benchmark.

    When LIU_PHASE_STATES=2, the IRS elements use
    binary phase shifts {0, pi}.

    When LIU_PHASE_STATES=0, continuous random
    phases are generated instead.
    """

    if LIU_PHASE_STATES and LIU_PHASE_STATES >= 2:

        return (
            rng.integers(0, LIU_PHASE_STATES, M)
            * (2 * np.pi / LIU_PHASE_STATES)
        )

    return rng.uniform(0, 2 * np.pi, M)


# ============================================================
# 13. LIU TRAINING OBSERVATION
# ============================================================

def liu_training_observation(
    G12, g1, g2, pilot, sigma_n, rng
):
    """
    Generate the training measurement for one
    randomly selected IRS configuration.

    The received signal follows the same ambient
    backscatter model as the original system.

    The training objective can use either:
    - RSS-like power statistic
    - CP-based triangle-channel statistic
    """

    y = (
        pilot * g1
        + beta * pilot * g2 * B * G12
        + complex_noise(sigma_n, rng)
    )

    if LIU_TRAIN_METRIC == "rss":
        return extract_rss(y)

    return extract_triangle_channel(y)


# ============================================================
# 14. ENTROPY-BOUNDED QUANTIZATION LEVELS
# ============================================================

def entropy_bounded_levels(metrics):
    """
    Estimate an entropy-based upper bound on the
    number of quantization groups.

    The training measurements are first represented
    by a histogram-based empirical distribution.

    Shannon entropy is calculated as:

        H = -sum_i(p_i * log2(p_i))

    The selected number of levels satisfies:

        L <= 2^H

    The number of levels is also limited by
    LIU_MAX_LEVELS.

    This histogram-based procedure is an adaptation
    choice and not an exact reproduction of the
    original benchmark's complete quantizer design.
    """

    T = len(metrics)

    # Select the histogram resolution.
    if LIU_ENTROPY_BINS is None:

        # Sturges' histogram rule.
        n_bins = int(
            np.ceil(np.log2(T) + 1)
        )

    else:
        n_bins = int(LIU_ENTROPY_BINS)

    if n_bins < 1:
        raise ValueError(
            "LIU_ENTROPY_BINS must be >= 1."
        )

    # Estimate the empirical histogram distribution.
    counts, _ = np.histogram(
        metrics,
        bins=n_bins
    )

    # Remove empty histogram bins.
    prob = counts[counts > 0] / T

    # Estimate Shannon entropy in bits.
    entropy = -np.sum(
        prob * np.log2(prob)
    )

    # Entropy-based maximum number of groups.
    max_allowed = max(
        1,
        int(np.floor(2.0 ** entropy))
    )

    # Enforce the configured upper bound.
    levels = min(
        LIU_MAX_LEVELS,
        max_allowed
    )

    return levels


# ============================================================
# 15. LIU-INSPIRED TRAINING AND SWITCHING HEURISTIC
# ============================================================

def liu_cp_heuristic(
    g12, g1I, gI2, g1, g2, sigma_n, rng
):
    """
    Implement the adapted Liu-inspired IRS heuristic.

    Main processing stages:

    1. Generate 31 random IRS configurations.
    2. Obtain noisy training measurements.
    3. Determine the number of quantization groups.
    4. Partition measurements into equal-width groups.
    5. Select IRS configurations for eight switching slots.

    The procedure is adapted to the CP-based ambient
    backscatter model used in this manuscript.

    It is not a complete reproduction of Liu et al.'s
    original secret-key-generation protocol.
    """

    if LIU_TRAINING < 2 or LIU_SLOTS < 1:
        raise ValueError(
            "Invalid Liu training or slot configuration."
        )

    # Generate one pilot for all training measurements.
    pilot = ofdm_symbol(rng)

    # Store the measured statistics.
    metrics = np.empty(LIU_TRAINING)

    # Store the corresponding composite channels.
    channels = np.empty(
        LIU_TRAINING,
        dtype=complex
    )

    # --------------------------------------------------------
    # STEP 1: TRAIN RANDOM IRS CONFIGURATIONS
    # --------------------------------------------------------

    for i in range(LIU_TRAINING):

        # Generate a random IRS phase configuration.
        phi = liu_random_phases(rng)

        # Calculate its effective inter-tag channel.
        channels[i] = composite_channel(
            g12, g1I, gI2, phi
        )

        # Measure its noisy training statistic.
        metrics[i] = liu_training_observation(
            channels[i],
            g1, g2,
            pilot, sigma_n, rng
        )

    # --------------------------------------------------------
    # STEP 2: SELECT THE NUMBER OF GROUPS
    # --------------------------------------------------------

    if LIU_ADAPTIVE_LEVELS:

        # Estimate the permitted number of groups
        # from the empirical measurement entropy.
        n_levels = entropy_bounded_levels(
            metrics
        )

    else:

        # Use the configured fixed number of groups.
        n_levels = int(LIU_GROUPS)

    if n_levels < 1:
        raise ValueError(
            "Quantization-group count must be >= 1."
        )

    # Find the observed training range.
    minimum = float(np.min(metrics))
    maximum = float(np.max(metrics))

    # --------------------------------------------------------
    # STEP 3: EQUAL-WIDTH GROUPING
    # --------------------------------------------------------

    # If all measurements are effectively equal,
    # place every configuration into one group.
    if (
        n_levels == 1
        or np.isclose(
            minimum,
            maximum,
            rtol=0,
            atol=1e-30
        )
    ):

        membership = np.zeros(
            LIU_TRAINING,
            dtype=int
        )

    else:

        # Calculate equal-width group intervals.
        group_width = (
            maximum - minimum
        ) / n_levels

        # Assign each measurement to a group.
        # Clipping handles the maximum endpoint.
        membership = np.minimum(
            (
                (metrics - minimum)
                / group_width
            ).astype(int),
            n_levels - 1
        )

    # Identify groups containing training samples.
    nonempty_groups = np.unique(
        membership
    )

    # Map each nonempty group to its member indices.
    members = {
        int(g): np.flatnonzero(
            membership == g
        )
        for g in nonempty_groups
    }

    # --------------------------------------------------------
    # STEP 4: IRS TIME-SLOT SWITCHING
    # --------------------------------------------------------

    # Store the composite channel selected for each slot.
    G_slots = np.empty(
        LIU_SLOTS,
        dtype=complex
    )

    for t in range(LIU_SLOTS):

        # Randomly select one nonempty measurement group.
        selected_group = int(
            rng.choice(nonempty_groups)
        )

        # Randomly select one trained configuration
        # belonging to that group.
        selected_index = int(
            rng.choice(
                members[selected_group]
            )
        )

        # Use its composite channel for this switching slot.
        G_slots[t] = channels[selected_index]

    return G_slots, n_levels


# ============================================================
# 16. RECIPROCAL TRIANGLE-CHANNEL OBSERVATIONS
# ============================================================

def triangle_pair(
    G12, g1, g2, s, noise1, noise2
):
    """
    Generate reciprocal observations at T1 and T2.

    Phase 1: T2 backscatters and T1 receives.
    Phase 2: T1 backscatters and T2 receives.

    Both observations depend on the same effective
    inter-tag channel G12.
    """

    # Observation at T1.
    y1 = (
        s * g1
        + beta * s * g2 * B * G12
        + noise1
    )

    # Observation at T2.
    y2 = (
        s * g2
        + beta * s * g1 * B * G12
        + noise2
    )

    return (
        extract_triangle_channel(y1),
        extract_triangle_channel(y2)
    )


def slot_statistics(
    G12, g1, g2, s, noise1, noise2
):
    """
    Generate both triangle-channel and RSS-like
    observations for one benchmark switching slot.

    Returns:
      - Triangle observation at T1
      - Triangle observation at T2
      - RSS observation at T1
      - RSS observation at T2
    """

    y1 = (
        s * g1
        + beta * s * g2 * B * G12
        + noise1
    )

    y2 = (
        s * g2
        + beta * s * g1 * B * G12
        + noise2
    )

    return (
        extract_triangle_channel(y1),
        extract_triangle_channel(y2),
        extract_rss(y1),
        extract_rss(y2)
    )


# ============================================================
# 17. MUTUAL INFORMATION ESTIMATION
# ============================================================

def mutual_info_bits(x, y):
    """
    Estimate continuous-valued mutual information
    using a k-nearest-neighbor-based estimator.

    The estimator returns MI in nats.
    Division by ln(2) converts the result to bits.

    This is an empirical estimate of statistical
    dependence, not an analytical secrecy rate.
    """

    x = np.asarray(x)
    y = np.asarray(y)

    # Avoid estimating MI from nearly constant data.
    if (
        np.std(x) < 1e-12
        or np.std(y) < 1e-12
    ):
        return 0.0

    mi_nats = mutual_info_regression(
        x.reshape(-1, 1),
        y,
        n_neighbors=3,
        random_state=SEED
    )[0]

    return max(
        0.0,
        mi_nats / np.log(2)
    )


# ============================================================
# 18. LIU BENCHMARK MI SAMPLING
# ============================================================

def liu_mutual_information(
    block_pairs,
    selected_slots
):
    """
    Estimate benchmark MI using one selected slot
    from each independent channel block.

    Expected input shape:
        (num_samples, LIU_SLOTS, 2)

    The two columns correspond to T1 and T2.

    Selecting one slot per block avoids treating
    all switching slots within the same channel
    realization as independent fading blocks.

    The same slot indices are used for RSS and
    triangle-based benchmark comparisons.
    """

    expected_shape = (
        num_samples,
        LIU_SLOTS,
        2
    )

    if block_pairs.shape != expected_shape:
        raise ValueError(
            "Unexpected Liu block-pair array shape."
        )

    # Extract one paired observation from each block.
    selected = block_pairs[
        np.arange(num_samples),
        selected_slots,
        :
    ]

    return mutual_info_bits(
        selected[:, 0],
        selected[:, 1]
    )


# ============================================================
# 19. MONTE CARLO SIMULATION AT ONE SNR
# ============================================================

def simulate_one_snr(
    snr_db,
    rng,
    liu_rng,
    show_progress=True
):
    """
    Evaluate the four schemes at one SNR value.

    Original schemes:
      - No IRS
      - Proposed SBF
      - Perfect CSI

    Benchmark:
      - Liu-inspired IRS heuristic

    The original schemes share the same channel blocks,
    OFDM waveform, and receiver noise realizations.

    The benchmark uses a separate RNG for its training,
    switching, and key-generation measurements.

    This preserves the original random-number sequence
    used by the No-IRS, SBF, and perfect-CSI methods.
    """

    sigma_n = noise_std(snr_db)

    # --------------------------------------------------------
    # STORAGE FOR ORIGINAL THREE SCHEMES
    # --------------------------------------------------------

    no_pairs = np.empty(
        (num_samples, 2)
    )

    sbf_pairs = np.empty(
        (num_samples, 2)
    )

    perfect_pairs = np.empty(
        (num_samples, 2)
    )

    # --------------------------------------------------------
    # STORAGE FOR LIU-INSPIRED BENCHMARK
    # --------------------------------------------------------

    # Triangle observations for all switching slots.
    liu_tri = np.empty(
        (num_samples * LIU_SLOTS, 2)
    )

    # RSS observations indexed by block and slot.
    liu_rss = np.empty(
        (num_samples, LIU_SLOTS, 2)
    )

    # Diagnostics for SBF optimization and grouping.
    normalized_gains = np.empty(num_samples)
    accepted_counts = np.empty(num_samples)
    levels_used = np.empty(num_samples)

    # --------------------------------------------------------
    # MONTE CARLO CHANNEL REALIZATIONS
    # --------------------------------------------------------

    for k in range(num_samples):

        # ----------------------------------------------------
        # GENERATE DIRECT CHANNELS
        # ----------------------------------------------------

        g1 = dominant_tap_channel(
            TAU_S1, D_S1, rng
        )

        g2 = dominant_tap_channel(
            TAU_S2, D_S2, rng
        )

        g12 = dominant_tap_channel(
            TAU_12, D_12, rng
        )

        # ----------------------------------------------------
        # GENERATE CASCADED IRS CHANNELS
        # ----------------------------------------------------

        g1I = link_amp(D_1I) * (
            rng.standard_normal(M)
            + 1j * rng.standard_normal(M)
        ) / np.sqrt(2)

        gI2 = link_amp(D_I2) * (
            rng.standard_normal(M)
            + 1j * rng.standard_normal(M)
        ) / np.sqrt(2)

        # ----------------------------------------------------
        # ORIGINAL THREE CONFIGURATIONS
        # ----------------------------------------------------

        # No IRS: direct inter-tag channel only.
        G_noirs = g12

        # Proposed SBF: noisy measurement-based optimization.
        G_sbf, accepted = sbf_algorithm(
            g12, g1I, gI2,
            g1, g2, sigma_n, rng
        )

        # Perfect CSI: ideal coherent phase alignment.
        G_perfect = perfect_alignment_channel(
            g12, g1I, gI2
        )

        # Ratio of selected SBF channel power to the
        # ideal perfect-CSI composite channel power.
        normalized_gains[k] = (
            abs(G_sbf) ** 2
            / max(
                abs(G_perfect) ** 2,
                1e-15
            )
        )

        accepted_counts[k] = accepted

        # ----------------------------------------------------
        # COMMON SIGNAL AND NOISE FOR ORIGINAL SCHEMES
        # ----------------------------------------------------

        # Using common waveform and noise realizations
        # supports a paired comparison of the schemes.
        s = ofdm_symbol(rng)

        noise1 = complex_noise(sigma_n, rng)
        noise2 = complex_noise(sigma_n, rng)

        # Without IRS.
        no_pairs[k] = triangle_pair(
            G_noirs, g1, g2,
            s, noise1, noise2
        )

        # With proposed SBF.
        sbf_pairs[k] = triangle_pair(
            G_sbf, g1, g2,
            s, noise1, noise2
        )

        # With perfect CSI.
        perfect_pairs[k] = triangle_pair(
            G_perfect, g1, g2,
            s, noise1, noise2
        )

        # ----------------------------------------------------
        # LIU-INSPIRED BENCHMARK
        # ----------------------------------------------------

        # Train random IRS configurations and select
        # composite channels for the switching slots.
        #
        # The benchmark RNG is independent of the
        # original simulation RNG.
        G_slots, levels_used[k] = liu_cp_heuristic(
            g12, g1I, gI2,
            g1, g2, sigma_n, liu_rng
        )

        # ----------------------------------------------------
        # BENCHMARK KEY-GENERATION SWITCHING SLOTS
        # ----------------------------------------------------

        for t in range(LIU_SLOTS):

            # Independent OFDM waveform for this slot.
            s_t = ofdm_symbol(liu_rng)

            # Receiver noise for the two legitimate tags.
            noise1_t = complex_noise(
                sigma_n, liu_rng
            )

            noise2_t = complex_noise(
                sigma_n, liu_rng
            )

            # Extract triangle and RSS observations.
            u1, u2, r1, r2 = slot_statistics(
                G_slots[t],
                g1, g2,
                s_t, noise1_t, noise2_t
            )

            # Store triangle observations.
            liu_tri[
                k * LIU_SLOTS + t
            ] = (u1, u2)

            # Store RSS observations.
            liu_rss[k, t] = (r1, r2)

        # Display progress during the main simulation.
        if (
            show_progress
            and (k + 1) % 1000 == 0
        ):

            print(
                f"SNR={snr_db:2d} dB: "
                f"{k + 1}/{num_samples}",
                flush=True
            )

    # --------------------------------------------------------
    # MUTUAL INFORMATION OF ORIGINAL SCHEMES
    # --------------------------------------------------------

    mi_no = mutual_info_bits(
        no_pairs[:, 0],
        no_pairs[:, 1]
    )

    mi_sbf = mutual_info_bits(
        sbf_pairs[:, 0],
        sbf_pairs[:, 1]
    )

    mi_perfect = mutual_info_bits(
        perfect_pairs[:, 0],
        perfect_pairs[:, 1]
    )

    # --------------------------------------------------------
    # BENCHMARK MI: ONE SLOT PER INDEPENDENT BLOCK
    # --------------------------------------------------------

    # Select one random switching slot for each
    # independent channel realization.
    selected_slots = liu_rng.integers(
        0,
        LIU_SLOTS,
        size=num_samples
    )

    # Reshape triangle observations into:
    # (channel blocks, switching slots, legitimate tags).
    liu_tri_blocks = liu_tri.reshape(
        num_samples,
        LIU_SLOTS,
        2
    )

    # Triangle-based benchmark MI.
    mi_liu_tri = liu_mutual_information(
        liu_tri_blocks,
        selected_slots
    )

    # --------------------------------------------------------
    # BENCHMARK RSS NORMALIZATION
    # --------------------------------------------------------

    # Normalize RSS measurements separately within
    # each channel block and for each legitimate tag.
    #
    # This removes block-level scale differences
    # before the benchmark RSS MI estimation.
    rss_denominator = np.maximum(
        np.mean(
            liu_rss,
            axis=1,
            keepdims=True
        ),
        np.finfo(float).tiny
    )

    rss_norm = liu_rss / rss_denominator

    # Estimate MI from the selected normalized RSS pairs.
    mi_liu_rss = liu_mutual_information(
        rss_norm,
        selected_slots
    )

    # Select the configured benchmark key metric.
    if LIU_KEY_METRIC == "rss":
        mi_liu = mi_liu_rss
    else:
        mi_liu = mi_liu_tri

    # Return MI values and optimization diagnostics.
    return (
        mi_no,
        mi_sbf,
        mi_perfect,
        np.mean(normalized_gains),
        np.mean(accepted_counts),
        mi_liu,
        mi_liu_rss,
        mi_liu_tri,
        np.mean(levels_used)
    )


