# ============================================================
# 14. FIGURE PLOTTING FUNCTION
# ============================================================

def plot_model(model, filename):
    """
    Plot the conditional MI curves for one
    eavesdropper observation model.

    Each figure contains four curves:
        - No IRS, rho=0
        - IRS-SBF, rho=0
        - No IRS, rho=0.9
        - IRS-SBF, rho=0.9

    Solid lines:
        rho=0

    Dashed lines:
        rho=0.9

    The figure is saved as a vector PDF.
    """

    # IEEE single-column figure dimensions.
    fig, ax = plt.subplots(
        figsize=(3.5, 2.5),
        dpi=300
    )

    # --------------------------------------------------------
    # CURVE DEFINITIONS
    # --------------------------------------------------------

    # Tuple format:
    # (correlation, scheme, color, marker, line style)
    curves = [
        (0.0, "noirs", "#e3342f", "o", "-"),
        (0.0, "sbf", "#2f9e44", "s", "-"),
        (0.9, "noirs", "#e3342f", "o", "--"),
        (0.9, "sbf", "#2f9e44", "s", "--")
    ]

    # --------------------------------------------------------
    # PLOT CONDITIONAL MI CURVES
    # --------------------------------------------------------

    for (
        rho,
        scheme,
        color,
        marker,
        linestyle
    ) in curves:

        # Scheme label.
        if scheme == "noirs":
            label = "Without IRS"
        else:
            label = "With IRS (SBF algorithm)"

        # Append eavesdropper correlation coefficient.
        label += (
            rf", $\rho_{{\mathrm{{corr}}}}={rho:g}$"
        )

        # Plot the simulated conditional MI values.
        ax.plot(
            snr_db_range,
            results[rho][f"{scheme}_{model}"],
            color=color,
            marker=marker,
            linestyle=linestyle,
            linewidth=1.8,
            markersize=5,
            label=label
        )

    # --------------------------------------------------------
    # AXIS LABELS
    # --------------------------------------------------------

    ax.set_xlabel(
        "SNR (dB)",
        fontweight="bold"
    )

    # Retained from the supplied figure implementation.
    #
    # The plotted values are conditional MI estimates.
    # Calling them achievable SKR requires additional
    # protocol and information-theoretic justification.
    ax.set_ylabel(
        "Secret Key Rate (bits/channel use)",
        fontweight="bold"
    )

    # --------------------------------------------------------
    # GRID AND AXIS FORMATTING
    # --------------------------------------------------------

    ax.grid(
        True,
        linestyle="--",
        linewidth=0.6,
        alpha=0.5
    )

    ax.set_axisbelow(True)

    # Axis border color.
    for spine in ax.spines.values():
        spine.set_color("0.3")

    # Bold tick labels.
    for tick in (
        ax.get_xticklabels()
        + ax.get_yticklabels()
    ):
        tick.set_fontweight("bold")

    # --------------------------------------------------------
    # LEGEND FORMATTING
    # --------------------------------------------------------

    legend = ax.legend(
        loc="upper left",
        fontsize=8.5,
        frameon=True,
        fancybox=False,
        edgecolor="black",
        framealpha=1.0,
        handlelength=2.2,
        handletextpad=0.4,
        borderpad=0.4
    )

    legend.get_frame().set_linewidth(1.2)

    for text in legend.get_texts():
        text.set_fontweight("bold")

    # Optimize figure spacing.
    fig.tight_layout(pad=0.4)

    # --------------------------------------------------------
    # SAVE VECTOR PDF
    # --------------------------------------------------------

    path = OUTPUT_DIR / filename

    plt.savefig(
        path,
        format="pdf",
        bbox_inches="tight",
        facecolor="white"
    )

    print(f"Saved: {path.resolve()}")

    plt.show()


