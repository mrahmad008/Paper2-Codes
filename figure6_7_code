def plot_model(model_key, filename):
    fig, ax = plt.subplots(figsize=(8, 6), dpi=300)

    ax.plot(snr_db_range, results[0.0][f"noirs_{model_key}"], color="#e3342f",
            marker="o", linestyle="-", linewidth=2, markersize=6,
            label=r"Without IRS, $\rho_{\mathrm{corr}}=0$")
    ax.plot(snr_db_range, results[0.0][f"sbf_{model_key}"], color="#2f9e44",
            marker="s", linestyle="-", linewidth=2, markersize=6,
            label=r"With IRS (SBF algorithm), $\rho_{\mathrm{corr}}=0$")
    ax.plot(snr_db_range, results[0.9][f"noirs_{model_key}"], color="#e3342f",
            marker="o", linestyle="--", linewidth=2, markersize=6,
            label=r"Without IRS, $\rho_{\mathrm{corr}}=0.9$")
    ax.plot(snr_db_range, results[0.9][f"sbf_{model_key}"], color="#2f9e44",
            marker="s", linestyle="--", linewidth=2, markersize=6,
            label=r"With IRS (SBF algorithm), $\rho_{\mathrm{corr}}=0.9$")

    ax.set_xlabel("SNR (dB)")
    ax.set_ylabel("Secret Key Rate (bits/channel use)")
    ax.grid(True, linestyle=":", linewidth=0.7, alpha=0.6)
    ax.set_axisbelow(True)
    ax.legend(fontsize=9.5, handlelength=4.0)
    for spine in ax.spines.values():
        spine.set_color('0.3')
    plt.tight_layout()

    output_path = OUTPUT_DIR / filename
    plt.savefig(output_path, dpi=600, bbox_inches="tight")
    print(f"Saved: {output_path.resolve()}")
    plt.show()


plot_model("m1", "figure6_skr_model1_fixed.png")
plot_model("m2", "figure7_skr_model2_fixed.png")
