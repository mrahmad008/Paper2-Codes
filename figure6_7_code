# ============================================================
# 1. SIMULATION PARAMETERS
# ============================================================

# Fixed random seed for reproducibility.
np.random.seed(42)

# Normalized ambient RF transmit power.
p = 1.0

# Complex backscatter reflection coefficient.
beta = 0.3 + 0.4j

# Number of independent fading realizations per
# SNR/correlation configuration.
#
# Can be overridden using the SIM_SAMPLES
# environment variable.
num_samples = int(
    os.getenv("SIM_SAMPLES", "5000")
)

# SNR sweep: 0, 5, 10, ..., 30 dB.
snr_db_range = np.arange(0, 31, 5)

# OFDM system parameters.
N = 256
Ncp = 64
L_max = 10

# Total OFDM symbol length including CP.
Nt = N + Ncp

# Number of ISI-free CP observations.
J = Ncp - L_max + 1

assert J == 55

# Number of IRS reflecting elements.
M = 128

# Number of one-bit stochastic beamforming iterations.
SBF_iterations = 30

# Maximum random phase perturbation.
delta = np.pi / 20

# Eavesdropper spatial correlation coefficients.
rho_values = [0.0, 0.9]

# Distance-dependent path-loss exponent.
ETA = 3.0

# Source-to-tag and direct inter-tag distances.
D_S1 = 8.0
D_S2 = 7.0
D_12 = 3.0

# Multipath channel tap counts.
TAU_S1 = 8
TAU_S2 = 7
TAU_12 = 3

# IRS-assisted propagation distances.
D_1I = float(os.getenv("D_1I", "3.0"))
D_I2 = float(os.getenv("D_I2", "3.0"))

# IRS-to-eavesdropper distance.
# Defaults to the same distance as D_1I.
D_ID = float(
    os.getenv("D_ID", str(D_1I))
)

# Output directory for figures and numerical results.
OUTPUT_DIR = Path("outputs_fig6_7_final")
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)


# ============================================================
# 2. CHANNEL MODEL
# ============================================================

def link_amp(distance):
    """
    Calculate the distance-dependent channel amplitude.

    The propagation power decreases according to:

        Received power proportional to d^(-ETA)

    Therefore, the complex channel amplitude scales as:

        d^(-ETA/2)
    """

    if distance <= 0:
        raise ValueError(
            "Distance must be positive."
        )

    return distance ** (-ETA / 2)


def generate_channel_taps(L):
    """
    Generate an L-tap Rayleigh fading channel.

    An exponentially decaying power-delay profile
    with 3 dB power reduction per tap is assumed.

    The tap powers are normalized so that their
    sum equals unity before path loss is applied.

    Each channel coefficient follows a circularly
    symmetric complex Gaussian distribution.
    """

    # Power ratio between consecutive taps.
    r = 10 ** (-3.0 / 10.0)

    # Exponential power-delay profile.
    powers = r ** np.arange(L)

    # Normalize total average channel power.
    powers /= powers.sum()

    # Generate independent complex Gaussian taps.
    return np.sqrt(powers / 2) * (
        np.random.randn(L)
        + 1j * np.random.randn(L)
    )


def dominant_tap_channel(L, distance):
    """
    Generate the effective scalar channel coefficient.

    The first tap of the multipath Rayleigh channel
    is selected as the dominant-tap approximation.

    Distance-dependent path loss is then applied.

    This reduces the multipath channel to one
    complex coefficient for the simulation.
    """

    return (
        generate_channel_taps(L)[0]
        * link_amp(distance)
    )


def dominant_tap_variance(L, distance):
    """
    Calculate the expected power of the dominant tap.

    The first-tap variance is determined by the
    normalized exponential power-delay profile
    and distance-dependent attenuation.
    """

    r = 10 ** (-3.0 / 10.0)

    return (
        link_amp(distance) ** 2
        / np.sum(r ** np.arange(L))
    )


def correlated_channel(reference, rho, variance):
    """
    Generate a spatially correlated complex channel.

    The correlated channel is modeled as:

        h_corr = rho*h_ref
                 + sqrt(1-rho^2)*sqrt(variance)*z

    where z is an independent CN(0,1) variable.

    rho = 0:
        Independent channel realization.

    rho = 0.9:
        Strong correlation with the reference channel.

    The model assumes real-valued rho in [0,1].
    """

    # Independent complex Gaussian component.
    z = (
        np.random.randn()
        + 1j * np.random.randn()
    ) / np.sqrt(2)

    return (
        rho * reference
        + np.sqrt(max(0.0, 1 - rho ** 2))
        * np.sqrt(variance) * z
    )


# ============================================================
# 3. OFDM SIGNAL GENERATION
# ============================================================

def ofdm_symbol():
    """
    Generate a QPSK-modulated OFDM symbol.

    The frequency-domain symbols are converted
    into the time domain using the inverse FFT.

    A cyclic prefix of length Ncp is prepended.

    The sqrt(N) factor maintains the intended
    time-domain power normalization.
    """

    # Random QPSK frequency-domain symbols.
    data = np.random.choice(
        [
            1 + 1j,
            1 - 1j,
            -1 + 1j,
            -1 - 1j
        ],
        N
    ) / np.sqrt(2)

    # Generate time-domain OFDM samples.
    x = np.fft.ifft(data) * np.sqrt(N)

    # Prepend cyclic prefix.
    return np.concatenate([
        x[-Ncp:],
        x
    ])


def backscatter_waveform():
    """
    Generate the bipolar backscatter modulation sequence.

    The waveform uses two reflection states:
        +1 and -1

    A sign reversal is applied at the midpoint
    of the complete OFDM symbol.

    This sequence is retained from the original
    simulation implementation.
    """

    b = np.ones(Nt, dtype=complex)

    # Reverse the backscatter sign in the second half.
    b[Nt // 2:] = -1

    return b


def extract_triangle_channel(y):
    """
    Extract the CP-based noncoherent triangle statistic.

    The CP and corresponding OFDM samples are
    separated by N sample positions.

    Difference observation:
        z_b = y[n] - y[n+N]

    Sum observation:
        z_d = y[n] + y[n+N]

    Triangle-channel statistic:
        mean(|z_b * z_d|)

    The first L_max-1 CP samples are excluded
    to avoid the assumed inter-symbol interference.

    This operation does not require explicit
    instantaneous CSI.
    """

    indices = np.arange(L_max - 1, Ncp)

    # Difference between CP and repeated OFDM samples.
    z_b = y[indices] - y[indices + N]

    # Sum of the corresponding samples.
    z_d = y[indices] + y[indices + N]

    # Noncoherent triangle-channel observation.
    return np.mean(np.abs(z_b * z_d))


# ============================================================
# 4. UNCONDITIONAL MUTUAL INFORMATION ESTIMATION
# ============================================================

def mi_knn(x, y):
    """
    Estimate I(X;Y) using a kNN-based MI estimator.

    The sklearn estimator returns MI in nats.

    Division by ln(2) converts the result into bits.

    This estimator is used to evaluate the
    statistical dependence between the two
    legitimate triangle-channel observations.
    """

    x = np.asarray(x).reshape(-1, 1)
    y = np.asarray(y)

    # Return zero if either variable has
    # negligible sample variation.
    if (
        np.std(x) < 1e-12
        or np.std(y) < 1e-12
    ):
        return 0.0

    mi = mutual_info_regression(
        x,
        y,
        random_state=42
    )[0]

    # Convert from nats to bits.
    return max(
        0.0,
        mi / np.log(2)
    )


# ============================================================
# 5. CONDITIONAL MUTUAL INFORMATION ESTIMATION
# ============================================================

def cond_mi_ksg(X, Y, Z, k=5):
    """
    Estimate conditional mutual information:

        I(X;Y|Z)

    using a Frenzel-Pompe-style kNN estimator.

    Interpretation:
        X = legitimate observation at T1
        Y = legitimate observation at T2
        Z = eavesdropper observation

    Conditional MI measures the residual
    statistical dependence between X and Y
    after conditioning on Z.

    The estimator uses:
        - Chebyshev (maximum) distance
        - k nearest neighbors
        - Strict neighborhood boundaries
        - Digamma-function correction

    The result is converted from nats to bits.

    Negative finite-sample estimates are clipped
    to zero in the original implementation.
    """

    def standardize(a):
        """
        Standardize one observation variable
        to zero mean and unit standard deviation.

        This reduces sensitivity to differences
        in the numerical scales of X, Y, and Z.
        """

        a = np.asarray(a, dtype=float)

        s = np.std(a)

        if s > 1e-12:
            return (
                a - np.mean(a)
            ) / s

        return np.zeros_like(a)

    # Standardize the three variables.
    x = standardize(X)
    y = standardize(Y)
    z = standardize(Z)

    # Ensure sufficient samples for kNN estimation.
    if len(x) <= k + 1:
        return 0.0

    # Joint observation space (X,Y,Z).
    xyz = np.column_stack([x, y, z])

    # Conditional subspaces.
    xz = np.column_stack([x, z])
    yz = np.column_stack([y, z])

    # Conditioning-variable space.
    z_only = z.reshape(-1, 1)

    # Construct a k-d tree in the joint space.
    tree_xyz = cKDTree(xyz)

    # Determine the kth-nearest-neighbor distance
    # using the maximum norm.
    distances, _ = tree_xyz.query(
        xyz,
        k=k + 1,
        p=np.inf
    )

    # Use a strict neighborhood boundary.
    # nextafter moves the radius slightly below
    # the kth-neighbor distance.
    eps = np.nextafter(
        distances[:, -1],
        0.0
    )

    def neighbor_count(data):
        """
        Count neighboring samples within the
        joint-space radius projected into a subspace.

        The query includes the sample itself;
        subtracting one excludes that sample.
        """

        tree = cKDTree(data)

        return np.maximum(
            tree.query_ball_point(
                data,
                r=eps,
                p=np.inf,
                return_length=True
            ) - 1,
            0
        )

    # Neighbor counts in conditional subspaces.
    nxz = neighbor_count(xz)
    nyz = neighbor_count(yz)
    nz = neighbor_count(z_only)

    # Frenzel-Pompe conditional MI estimator.
    #
    # The digamma terms correct for finite-sample
    # neighbor counts in the projected spaces.
    cmi = (
        digamma(k)
        - np.mean(
            digamma(nxz + 1)
            + digamma(nyz + 1)
            - digamma(nz + 1)
        )
    )

    # Convert nats to bits and clip negative estimates.
    return max(
        0.0,
        cmi / np.log(2)
    )


# ============================================================
# 6. SINGLE-BIT FEEDBACK ALGORITHM
# ============================================================

def sbf_algorithm(
    g12,
    g1I,
    gI2,
    g1,
    g2,
    sigma_n
):
    """
    Perform measurement-based stochastic beamforming.

    The IRS phase configuration is optimized using
    noisy CP-based triangle-channel observations.

    Procedure:
        1. Initialize random IRS phases.
        2. Measure the initial triangle statistic.
        3. Generate random phase perturbations.
        4. Measure the candidate configuration.
        5. Compare the candidate and stored metrics.
        6. Accept the candidate if it improves the metric.

    One binary accept/reject decision is generated
    during each perturbation iteration.

    The simulation assumes ideal delivery of the
    feedback decision to the IRS controller.

    Physical passive-backscatter feedback transmission,
    reception errors, and signaling energy are not
    explicitly modeled in Figures 6 and 7.

    Returns:
        G_best:
            Selected composite inter-tag channel.

        phi_best:
            Selected IRS phase configuration.
    """

    # Generate a fixed OFDM pilot for this SBF procedure.
    pilot = ofdm_symbol()

    # Generate the bipolar backscatter waveform.
    b = backscatter_waveform()

    # Direct ambient signal component.
    direct = pilot * g1

    def composite(phi):
        """
        Calculate the direct plus IRS-reflected channel.

        The IRS contribution is coherently summed
        using the current phase configuration.

        No 1/sqrt(M) normalization is applied.
        """

        return (
            g12
            + np.sum(
                g1I
                * np.exp(1j * phi)
                * gI2
            )
        )

    def metric(G):
        """
        Evaluate a noisy CP-based SBF feedback metric.

        A new AWGN realization is generated for
        each phase configuration measurement.
        """

        noise = sigma_n * (
            np.random.randn(Nt)
            + 1j * np.random.randn(Nt)
        ) / np.sqrt(2)

        # Received waveform at the coordinating tag.
        y = (
            direct
            + beta * pilot * g2 * b * G
            + noise
        )

        return extract_triangle_channel(y)

    # --------------------------------------------------------
    # INITIAL IRS CONFIGURATION
    # --------------------------------------------------------

    # Initialize each IRS phase uniformly in [0, 2pi).
    phi_best = np.random.uniform(
        0,
        2 * np.pi,
        M
    )

    # Initial composite channel.
    G_best = composite(phi_best)

    # Initial noisy triangle-channel observation.
    metric_best = metric(G_best)

    # --------------------------------------------------------
    # ITERATIVE STOCHASTIC BEAMFORMING
    # --------------------------------------------------------

    for _ in range(SBF_iterations):

        # Perturb every IRS phase independently.
        phi_new = (
            phi_best
            + np.random.uniform(
                -delta,
                delta,
                M
            )
        )

        # Composite channel under the candidate phases.
        G_new = composite(phi_new)

        # Noisy feedback metric for the candidate.
        metric_new = metric(G_new)

        # One-bit feedback decision:
        #
        # b(k) = 1 if the candidate metric improves.
        # b(k) = 0 otherwise.
        #
        # The controller retains the candidate
        # only when the received decision is positive.
        #
        # This idealized simulation directly implements
        # the decision without modeling its RF delivery.
        if metric_new > metric_best:

            # Accept candidate IRS phases.
            phi_best = phi_new

            # Update the selected composite channel.
            G_best = G_new

            # Update the stored feedback metric.
            metric_best = metric_new

    return G_best, phi_best


# ============================================================
# 7. MONTE CARLO SIMULATION FOR ONE SNR
# ============================================================

def simulate_one_snr(snr_db, rho):
    """
    Evaluate the legitimate and eavesdropper
    observations at a specified SNR and correlation.

    The function simulates:
        - No-IRS configuration
        - IRS-assisted SBF configuration
        - Eavesdropper observation model 1
        - Eavesdropper observation model 2

    For each channel realization, the legitimate
    and eavesdropper channel coefficients are
    generated and the corresponding observations
    are collected.

    MI and conditional MI are estimated across
    the Monte Carlo realizations.
    """

    # --------------------------------------------------------
    # REFERENCE NOISE POWER
    # --------------------------------------------------------

    # Normalize noise against the average received
    # backscatter power of the direct No-IRS link.
    #
    # The same noise normalization is applied
    # to all schemes and eavesdropper models.
    baseline_power = (
        p * abs(beta)**2
        * dominant_tap_variance(TAU_S2, D_S2)
        * dominant_tap_variance(TAU_12, D_12)
    )

    # Complex receiver-noise standard deviation.
    sigma_n = np.sqrt(
        baseline_power * 10**(-snr_db / 10)
    )

    # --------------------------------------------------------
    # STORAGE FOR NO-IRS OBSERVATIONS
    # --------------------------------------------------------

    U1_noirs, U2_noirs = [], []
    Ud1_noirs, Ud2_noirs = [], []

    # --------------------------------------------------------
    # STORAGE FOR IRS-SBF OBSERVATIONS
    # --------------------------------------------------------

    U1_sbf, U2_sbf = [], []
    Ud1_sbf, Ud2_sbf = [], []

    # --------------------------------------------------------
    # MONTE CARLO CHANNEL REALIZATIONS
    # --------------------------------------------------------

    for _ in range(num_samples):

        # ----------------------------------------------------
        # LEGITIMATE DIRECT CHANNELS
        # ----------------------------------------------------

        # Ambient source to tag T1.
        g1 = dominant_tap_channel(
            TAU_S1,
            D_S1
        )

        # Ambient source to tag T2.
        g2 = dominant_tap_channel(
            TAU_S2,
            D_S2
        )

        # Direct inter-tag channel.
        g12 = dominant_tap_channel(
            TAU_12,
            D_12
        )

        # ----------------------------------------------------
        # IRS-ASSISTED CHANNELS
        # ----------------------------------------------------

        # Channel from T1 to the IRS.
        g1I = link_amp(D_1I) * (
            np.random.randn(M)
            + 1j * np.random.randn(M)
        ) / np.sqrt(2)

        # Channel from IRS to T2.
        gI2 = link_amp(D_I2) * (
            np.random.randn(M)
            + 1j * np.random.randn(M)
        ) / np.sqrt(2)

        # ----------------------------------------------------
        # PROPOSED SBF OPTIMIZATION
        # ----------------------------------------------------

        # Optimize IRS phases using noisy measurements.
        #
        # The resulting phase configuration is also
        # used to calculate the IRS-assisted channels
        # observed by the eavesdropper.
        G12_sbf, phi = sbf_algorithm(
            g12,
            g1I,
            gI2,
            g1,
            g2,
            sigma_n
        )

        # ----------------------------------------------------
        # EAVESDROPPER DIRECT CHANNELS
        # ----------------------------------------------------

        # Reference variance for source-to-T1 channel.
        v_g1 = dominant_tap_variance(
            TAU_S1,
            D_S1
        )

        # Reference variance for inter-tag channel.
        v_g12 = dominant_tap_variance(
            TAU_12,
            D_12
        )

        # Source-to-eavesdropper channel.
        #
        # Correlated with g1 according to rho.
        gd = correlated_channel(
            g1,
            rho,
            v_g1
        )

        # T1-to-eavesdropper direct channel.
        #
        # Correlated with the legitimate inter-tag
        # channel g12.
        g1d = correlated_channel(
            g12,
            rho,
            v_g12
        )

        # T2-to-eavesdropper direct channel.
        #
        # Generated independently in this model.
        g2d = np.sqrt(v_g12) * (
            np.random.randn()
            + 1j * np.random.randn()
        ) / np.sqrt(2)

        # ----------------------------------------------------
        # CORRELATED IRS-TO-EAVESDROPPER CHANNEL
        # ----------------------------------------------------

        # Independent component of the IRS-to-
        # eavesdropper channel.
        gId_ind = link_amp(D_ID) * (
            np.random.randn(M)
            + 1j * np.random.randn(M)
        ) / np.sqrt(2)

        # Construct an IRS-to-eavesdropper channel
        # correlated with the IRS-to-T2 channel.
        #
        # The amplitude ratio compensates for
        # potentially different propagation distances.
        gId = (
            rho * gI2
            * (
                link_amp(D_ID)
                / link_amp(D_I2)
            )
            + np.sqrt(
                max(0.0, 1 - rho ** 2)
            ) * gId_ind
        )

        # IRS phase response selected by SBF.
        phase = np.exp(1j * phi)

        # ----------------------------------------------------
        # IRS-ASSISTED EAVESDROPPER CHANNELS
        # ----------------------------------------------------

        # Effective channel from T1 to eavesdropper.
        G1d_sbf = (
            g1d
            + np.sum(
                gId * phase * g1I
            )
        )

        # Effective channel from T2 to eavesdropper.
        G2d_sbf = (
            g2d
            + np.sum(
                gId * phase * gI2
            )
        )

        # ----------------------------------------------------
        # OFDM SIGNAL AND RECEIVER NOISE
        # ----------------------------------------------------

        # Generate one OFDM waveform for both schemes.
        s = ofdm_symbol()

        # Backscatter modulation sequence.
        b = backscatter_waveform()

        # Independent AWGN at legitimate tag T1.
        noise1 = sigma_n * (
            np.random.randn(Nt)
            + 1j * np.random.randn(Nt)
        ) / np.sqrt(2)

        # Independent AWGN at legitimate tag T2.
        noise2 = sigma_n * (
            np.random.randn(Nt)
            + 1j * np.random.randn(Nt)
        ) / np.sqrt(2)

        # ----------------------------------------------------
        # EAVESDROPPER CHANNEL ESTIMATION NOISE
        # ----------------------------------------------------

        def cnoise():
            """
            Generate scalar complex estimation noise.

            This represents imperfect eavesdropper
            channel knowledge rather than a complete
            received-waveform or estimation protocol.
            """

            return sigma_n * (
                np.random.randn()
                + 1j * np.random.randn()
            ) / np.sqrt(2)

        # Estimation errors for direct channels.
        egd = cnoise()
        eg1 = cnoise()
        eg2 = cnoise()

        # Estimation errors for effective channels.
        eG1d = cnoise()
        eG2d = cnoise()

        # ----------------------------------------------------
        # LEGITIMATE AND EAVESDROPPER OBSERVATIONS
        # ----------------------------------------------------

        def observations(G12, G1d, G2d):
            """
            Generate the legitimate triangle-channel
            observations and two eavesdropper statistics.

            Legitimate tags use CP-based noncoherent
            triangle-channel extraction.

            The eavesdropper is modeled as having noisy
            complex channel estimates.

            Model 1:
                Ud1 = |gd_hat * G2d_hat * g2_hat|

            Model 2:
                Ud2 = |G1d_hat * g1_hat
                        * G2d_hat * g2_hat|

            These are the specific observation proxies
            used in the supplied simulation.
            """

            # -----------------------------------------------
            # LEGITIMATE OBSERVATION AT T1
            # -----------------------------------------------

            # T2 backscatters the incident ambient signal.
            y1 = (
                s * g1
                + beta * s * g2 * b * G12
                + noise1
            )

            # -----------------------------------------------
            # LEGITIMATE OBSERVATION AT T2
            # -----------------------------------------------

            # T1 backscatters the incident ambient signal.
            y2 = (
                s * g2
                + beta * s * g1 * b * G12
                + noise2
            )

            # Extract reciprocal noncoherent observations.
            u1 = extract_triangle_channel(y1)
            u2 = extract_triangle_channel(y2)

            # -----------------------------------------------
            # IMPERFECT EAVESDROPPER CHANNEL ESTIMATES
            # -----------------------------------------------

            gd_hat = gd + egd
            g1_hat = g1 + eg1
            g2_hat = g2 + eg2

            G1d_hat = G1d + eG1d
            G2d_hat = G2d + eG2d

            # -----------------------------------------------
            # EAVESDROPPER MODEL 1
            # -----------------------------------------------

            # Magnitude of the three-channel product.
            ud1 = np.abs(
                gd_hat
                * G2d_hat
                * g2_hat
            )

            # -----------------------------------------------
            # EAVESDROPPER MODEL 2
            # -----------------------------------------------

            # Magnitude of the four-channel product.
            ud2 = np.abs(
                G1d_hat
                * g1_hat
                * G2d_hat
                * g2_hat
            )

            return u1, u2, ud1, ud2

        # ----------------------------------------------------
        # WITHOUT IRS
        # ----------------------------------------------------

        # Only direct inter-tag and eavesdropper paths.
        n = observations(
            g12,
            g1d,
            g2d
        )

        # ----------------------------------------------------
        # WITH IRS-SBF
        # ----------------------------------------------------

        # Use the SBF-optimized composite channel
        # and IRS-assisted eavesdropper channels.
        s_out = observations(
            G12_sbf,
            G1d_sbf,
            G2d_sbf
        )

        # ----------------------------------------------------
        # STORE NO-IRS OBSERVATIONS
        # ----------------------------------------------------

        U1_noirs.append(n[0])
        U2_noirs.append(n[1])

        Ud1_noirs.append(n[2])
        Ud2_noirs.append(n[3])

        # ----------------------------------------------------
        # STORE IRS-SBF OBSERVATIONS
        # ----------------------------------------------------

        U1_sbf.append(s_out[0])
        U2_sbf.append(s_out[1])

        Ud1_sbf.append(s_out[2])
        Ud2_sbf.append(s_out[3])

    # ========================================================
    # 8. UNCONDITIONAL MUTUAL INFORMATION
    # ========================================================

    # Legitimate mutual information without IRS.
    mi_noirs = mi_knn(
        U1_noirs,
        U2_noirs
    )

    # Legitimate mutual information with SBF-optimized IRS.
    mi_sbf = mi_knn(
        U1_sbf,
        U2_sbf
    )

    # ========================================================
    # 9. CONDITIONAL MUTUAL INFORMATION
    # ========================================================

    # --------------------------------------------------------
    # EAVESDROPPER MODEL 1
    # --------------------------------------------------------

    # Conditional MI without IRS.
    noirs_m1 = cond_mi_ksg(
        U1_noirs,
        U2_noirs,
        Ud1_noirs
    )

    # Conditional MI with IRS-SBF.
    sbf_m1 = cond_mi_ksg(
        U1_sbf,
        U2_sbf,
        Ud1_sbf
    )

    # --------------------------------------------------------
    # EAVESDROPPER MODEL 2
    # --------------------------------------------------------

    # Conditional MI without IRS.
    noirs_m2 = cond_mi_ksg(
        U1_noirs,
        U2_noirs,
        Ud2_noirs
    )

    # Conditional MI with IRS-SBF.
    sbf_m2 = cond_mi_ksg(
        U1_sbf,
        U2_sbf,
        Ud2_sbf
    )

    # ========================================================
    # 10. WORST-CASE CONDITIONAL MI PROXY
    # ========================================================

    # Select the smaller conditional MI across the
    # two eavesdropper observation models.
    #
    # This provides a conservative numerical proxy
    # within the two considered observation models.
    #
    # It is not a proof of achievable secret-key rate.
    skr_noirs = min(
        noirs_m1,
        noirs_m2
    )

    skr_sbf = min(
        sbf_m1,
        sbf_m2
    )

    return (
        noirs_m1,
        noirs_m2,
        sbf_m1,
        sbf_m2,
        mi_noirs,
        mi_sbf,
        skr_noirs,
        skr_sbf
    )


