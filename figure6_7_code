
import numpy as np
import matplotlib.pyplot as plt
import pandas as pd
from pathlib import Path
from sklearn.feature_selection import mutual_info_regression

np.random.seed(42)

# ============================================================
# Fixed reproduction of manuscript Figures 6 and 7
#
# Fixes applied vs. the previous version:
#   1. Channel generation: replaced the broken equivalent_scalar_channel()
#      (which normalized by its own magnitude, giving a bounded,
#      non-Rayleigh distribution) with taps[0], the correct CSCG /
#      Rayleigh-distributed scalar channel used throughout Figures 2-5.
#   2. SKR computation: replaced the Gaussian partial-correlation formula
#      (only exact for jointly Gaussian data; U1,U2,Ud are magnitudes of
#      products of complex Gaussians, i.e. NOT Gaussian) with a
#      nonparametric, k-NN-based conditional MI estimator via quantile
#      binning of Ud, consistent with the k-NN estimator (mutual_info_
#      regression) already used for the unconditional MI in Figure 3.
#      This guarantees I(U1;U2|Ud) is computed the same way I(U1;U2) is,
#      removing the estimator mismatch that caused SKR > MI.
# ============================================================

# ------------------------------------------------------------
# Simulation parameters (unchanged, matches Table 1)
# ------------------------------------------------------------
p = 1.0
beta = 0.3 + 0.4j
num_samples = 1000
snr_db_range = np.arange(0, 31, 5)

N = 256
Ncp = 64
L_max = 10
Nt = N + Ncp

M = 128
SBF_iterations = 30
delta = np.pi / 20

rho_values = [0.0, 0.9]

OUTPUT_DIR = Path("./outputs")
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)


# ------------------------------------------------------------
# Channel / signal helpers
# ------------------------------------------------------------
def generate_channel_taps(L):
    """Rayleigh multipath channel with exponential PDP, 3 dB decay/tap."""
    decay_per_tap_db = 3.0
    r = 10 ** (-decay_per_tap_db / 10.0)
    power = r ** np.arange(L)
    power = power / np.sum(power)
    taps = np.sqrt(power / 2) * (np.random.randn(L) + 1j * np.random.randn(L))
    return taps


def dominant_tap_channel(L):
    """
    FIX: return the first (dominant) tap directly, giving a proper
    zero-mean CSCG scalar with Rayleigh-distributed magnitude -- matching
    the channel model used in Figures 2-5, and consistent with the
    system model's stated CSCG/Rayleigh assumption.
    """
    taps = generate_channel_taps(L)
    return taps[0]


def generate_correlated_scalar(ref, rho):
    """Generate CSCG scalar correlated with 'ref' by rho."""
    noise = (np.random.randn() + 1j * np.random.randn()) / np.sqrt(2)
    return rho * ref + np.sqrt(max(0.0, 1.0 - rho ** 2)) * noise


def ofdm_symbol(N, Ncp):
    data = np.random.choice([1 + 1j, 1 - 1j, -1 + 1j, -1 - 1j], N) / np.sqrt(2)
    x = np.fft.ifft(data, N) * np.sqrt(N)
    cp = x[-Ncp:]
    return np.concatenate([cp, x])


def backscatter_waveform(Nt, bit=1):
    if bit == 0:
        return -np.ones(Nt, dtype=complex)
    waveform = np.ones(Nt, dtype=complex)
    waveform[Nt // 2:] = -1
    return waveform


def extract_triangle_channel(y, N, Ncp, L_max):
    start = L_max - 1
    end = Ncp - 1
    values = []
    for n in range(start, end + 1):
        z_b = y[n] - y[n + N]
        z_d = y[n] + y[n + N]
        values.append(np.abs(z_b * z_d))
    return np.mean(values)


# ------------------------------------------------------------
# Nonparametric MI / conditional MI (k-NN based, SAME estimator family
# as Figure 3's mutual_info_regression -- the Kraskov/KSG k-NN approach)
# ------------------------------------------------------------
from scipy.spatial import cKDTree
from scipy.special import digamma


def mi_knn(x, y):
    """Unconditional MI via k-NN estimator -- IDENTICAL method to Figure 3."""
    x = np.asarray(x, dtype=float).reshape(-1, 1)
    y = np.asarray(y, dtype=float)
    if np.std(x) < 1e-12 or np.std(y) < 1e-12:
        return 0.0
    mi_nats = mutual_info_regression(x, y, random_state=42)[0]
    return max(0.0, mi_nats / np.log(2))


def cond_mi_ksg(X, Y, Z, k=5):
    """
    Conditional mutual information I(X;Y|Z) via the Frenzel-Pompe (2007)
    extension of the Kraskov-Stogbauer-Grassberger (KSG) k-NN estimator --
    the same k-NN estimator family underlying Figure 3's mutual_info_
    regression (which implements the 2-variable KSG/Kraskov estimator).
    Uses the FULL sample set directly (no binning, no sample-size
    mismatch), so I(X;Y|Z) and I(X;Y) are estimated with the same
    effective sample size and estimator family, avoiding the small-sample
    bias that caused spurious SKR > MI violations under quantile binning.
    """
    def z(a):
        a = np.asarray(a, dtype=float)
        s = np.std(a)
        return (a - np.mean(a)) / s if s > 1e-12 else np.zeros_like(a)

    x, y, zz = z(X), z(Y), z(Z)
    n = len(x)
    if n <= k + 1:
        return 0.0

    xyz = np.column_stack([x, y, zz])
    xz = np.column_stack([x, zz])
    yz = np.column_stack([y, zz])
    zz2 = zz.reshape(-1, 1)

    tree_xyz = cKDTree(xyz)
    # k-th nearest neighbor distance in the joint (X,Y,Z) space (Chebyshev norm)
    dists, _ = tree_xyz.query(xyz, k=k + 1, p=np.inf)
    eps = dists[:, -1]

    tree_xz = cKDTree(xz)
    tree_yz = cKDTree(yz)
    tree_z = cKDTree(zz2)

    n_xz = tree_xz.query_ball_point(xz, r=eps, p=np.inf, return_length=True) - 1
    n_yz = tree_yz.query_ball_point(yz, r=eps, p=np.inf, return_length=True) - 1
    n_z = tree_z.query_ball_point(zz2, r=eps, p=np.inf, return_length=True) - 1

    n_xz = np.maximum(n_xz, 0)
    n_yz = np.maximum(n_yz, 0)
    n_z = np.maximum(n_z, 0)

    cmi_nats = (digamma(k) - np.mean(digamma(n_xz + 1) + digamma(n_yz + 1) - digamma(n_z + 1)))
    cmi_bits = max(0.0, cmi_nats / np.log(2))
    return cmi_bits


def cond_mi_knn(U1, U2, Ud, n_bins=8):
    """Kept for backward compatibility; no longer used (see cond_mi_ksg)."""
    return cond_mi_ksg(U1, U2, Ud)


# ------------------------------------------------------------
# SBF algorithm (unchanged)
# ------------------------------------------------------------
def sbf_algorithm(g12_direct, g1_I, g_I2):
    phi_best = np.random.uniform(0.0, 2.0 * np.pi, M)

    def composite_channel(phi):
        irs_component = np.sum(g1_I * np.exp(1j * phi) * g_I2) / np.sqrt(M)
        return g12_direct + irs_component

    G_best = composite_channel(phi_best)
    metric_best = np.abs(G_best)

    for _ in range(SBF_iterations):
        perturbation = np.random.uniform(-delta, delta, M)
        phi_new = phi_best + perturbation
        G_new = composite_channel(phi_new)
        metric_new = np.abs(G_new)
        if metric_new > metric_best:
            phi_best = phi_new
            G_best = G_new
            metric_best = metric_new

    return G_best, phi_best


# ------------------------------------------------------------
# Simulation for one SNR and one rho
# ------------------------------------------------------------
def simulate_one_snr(snr_db, rho):
    sigma_n = np.sqrt(10.0 ** (-snr_db / 10.0))
    L_h = max(1, L_max // 2)

    U1_noirs, U2_noirs, Ud1_noirs, Ud2_noirs = [], [], [], []
    U1_sbf, U2_sbf, Ud1_sbf, Ud2_sbf = [], [], [], []

    for _ in range(num_samples):
        # Legitimate channels -- FIX: use dominant_tap_channel, not the
        # broken equivalent_scalar_channel
        g1 = dominant_tap_channel(L_h)
        g2 = dominant_tap_channel(L_h)
        g12_direct = dominant_tap_channel(L_h)

        g1_I = (np.random.randn(M) + 1j * np.random.randn(M)) / np.sqrt(2)
        g_I2 = (np.random.randn(M) + 1j * np.random.randn(M)) / np.sqrt(2)

        G12_sbf, theta_star = sbf_algorithm(g12_direct, g1_I, g_I2)
        G12_noirs = g12_direct

        # Eavesdropper channels
        g_d = generate_correlated_scalar(g1, rho)

        # Per the manuscript's OWN derivation (Eq. 28): proximity gives
        # g_d ~ g1 and G_{1,d} ~ G_{2,1}, so G_{1,d} carries the injected
        # proximity correlation with the composite channel, while G_{2,d}
        # is Darth's independently measured multiplier used in the
        # division attack u_1 ~ u_d^2 / G_{2,d}.
        g1d_direct = generate_correlated_scalar(g12_direct, rho)
        g2d_direct = (np.random.randn() + 1j * np.random.randn()) / np.sqrt(2)

        g_Id = (np.random.randn(M) + 1j * np.random.randn(M)) / np.sqrt(2)
        phase = np.exp(1j * theta_star)

        G1d_noirs = g1d_direct
        G2d_noirs = g2d_direct

        G1d_sbf = g1d_direct + np.sum(g_Id * phase * g1_I) / np.sqrt(M)
        G2d_sbf = g2d_direct + np.sum(g_Id * phase * g_I2) / np.sqrt(M)

        s_t = ofdm_symbol(N, Ncp)
        b = backscatter_waveform(Nt, bit=1)

        def get_estimates(G12, G1d, G2d):
            back_T1 = beta * (s_t * g2) * b * G12
            direct_T1 = s_t * g1
            noise1 = sigma_n * (np.random.randn(Nt) + 1j * np.random.randn(Nt)) / np.sqrt(2)
            y1 = back_T1 + direct_T1 + noise1
            u1 = extract_triangle_channel(y1, N, Ncp, L_max)

            back_T2 = beta * (s_t * g1) * b * G12
            direct_T2 = s_t * g2
            noise2 = sigma_n * (np.random.randn(Nt) + 1j * np.random.randn(Nt)) / np.sqrt(2)
            y2 = back_T2 + direct_T2 + noise2
            u2 = extract_triangle_channel(y2, N, Ncp, L_max)

            ud1_clean = np.abs(g_d * G2d * g2)
            ud2_clean = np.abs(G1d * g1 * G2d * g2)

            noise_d1 = sigma_n * np.abs((np.random.randn() + 1j * np.random.randn()) / np.sqrt(2))
            noise_d2 = sigma_n * np.abs((np.random.randn() + 1j * np.random.randn()) / np.sqrt(2))

            ud1 = ud1_clean + noise_d1
            ud2 = ud2_clean + noise_d2

            return u1, u2, ud1, ud2

        u1n, u2n, ud1n, ud2n = get_estimates(G12_noirs, G1d_noirs, G2d_noirs)
        u1s, u2s, ud1s, ud2s = get_estimates(G12_sbf, G1d_sbf, G2d_sbf)

        U1_noirs.append(u1n); U2_noirs.append(u2n)
        Ud1_noirs.append(ud1n); Ud2_noirs.append(ud2n)
        U1_sbf.append(u1s); U2_sbf.append(u2s)
        Ud1_sbf.append(ud1s); Ud2_sbf.append(ud2s)

    U1_noirs, U2_noirs = np.asarray(U1_noirs), np.asarray(U2_noirs)
    Ud1_noirs, Ud2_noirs = np.asarray(Ud1_noirs), np.asarray(Ud2_noirs)
    U1_sbf, U2_sbf = np.asarray(U1_sbf), np.asarray(U2_sbf)
    Ud1_sbf, Ud2_sbf = np.asarray(Ud1_sbf), np.asarray(Ud2_sbf)

    # Unconditional MI (for verification that SKR <= MI)
    mi_noirs = mi_knn(U1_noirs, U2_noirs)
    mi_sbf = mi_knn(U1_sbf, U2_sbf)

    # Conditional MI / SKR via the multivariate KSG estimator (same k-NN
    # family as Figure 3, full sample set, no binning)
    no_irs_model1 = cond_mi_ksg(U1_noirs, U2_noirs, Ud1_noirs)
    no_irs_model2 = cond_mi_ksg(U1_noirs, U2_noirs, Ud2_noirs)
    irs_model1 = cond_mi_ksg(U1_sbf, U2_sbf, Ud1_sbf)
    irs_model2 = cond_mi_ksg(U1_sbf, U2_sbf, Ud2_sbf)

    skr_noirs = min(no_irs_model1, no_irs_model2)
    skr_sbf = min(irs_model1, irs_model2)

    return (
        max(0.0, no_irs_model1), max(0.0, no_irs_model2),
        max(0.0, irs_model1), max(0.0, irs_model2),
        mi_noirs, mi_sbf, skr_noirs, skr_sbf
    )


# ------------------------------------------------------------
# Run full simulation
# ------------------------------------------------------------
results = {rho: {"noirs_m1": [], "noirs_m2": [], "sbf_m1": [], "sbf_m2": []} for rho in rho_values}

print("Verification that SKR <= MI at every point:\n")
for rho in rho_values:
    print(f"--- rho_corr = {rho} ---")
    for snr_db in snr_db_range:
        n1, n2, s1, s2, mi_noirs, mi_sbf, skr_noirs, skr_sbf = simulate_one_snr(snr_db, rho)

        results[rho]["noirs_m1"].append(n1)
        results[rho]["noirs_m2"].append(n2)
        results[rho]["sbf_m1"].append(s1)
        results[rho]["sbf_m2"].append(s2)

        ok_noirs = "OK" if skr_noirs <= mi_noirs + 1e-6 else "VIOLATION"
        ok_sbf = "OK" if skr_sbf <= mi_sbf + 1e-6 else "VIOLATION"

        print(f"SNR={snr_db:2d} dB | No-IRS: MI={mi_noirs:.3f}, SKR={skr_noirs:.3f} [{ok_noirs}] | "
              f"SBF: MI={mi_sbf:.3f}, SKR={skr_sbf:.3f} [{ok_sbf}]")

# ------------------------------------------------------------
# Save results
# ------------------------------------------------------------
rows = []
for rho in rho_values:
    for i, snr in enumerate(snr_db_range):
        rows.append({
            "rho_corr": rho, "SNR_dB": snr,
            "NoIRS_Model1": results[rho]["noirs_m1"][i],
            "IRS_SBF_Model1": results[rho]["sbf_m1"][i],
            "NoIRS_Model2": results[rho]["noirs_m2"][i],
            "IRS_SBF_Model2": results[rho]["sbf_m2"][i],
        })

df = pd.DataFrame(rows)
csv_path = OUTPUT_DIR / "corrected_fig6_fig7_results_v2.csv"
df.to_csv(csv_path, index=False)
print("\nNumerical results:")
print(df.round(4))

