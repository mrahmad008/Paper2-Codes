import os
import numpy as np
import matplotlib.pyplot as plt
from sklearn.feature_selection import mutual_info_regression
from scipy.interpolate import PchipInterpolator
from tqdm import tqdm

#np.random.seed(42)

# ------------------------------------------------------------
#  Parameters (matching Table 1 / Figures 2-4's finalized setup)
# ------------------------------------------------------------
p = 1.0
beta = 0.3 + 0.4j
num_samples = 1000                  # channel realizations per SNR point
snr_db_range = np.arange(0, 31, 5)  # 0,5,...,30 dB

N = 256
Ncp = 64
L_max = 10          # l_c
Nt = N + Ncp

M = 128
SBF_iterations = 30
delta = np.pi / 20   # eps_m(k) ~ U[-delta, delta]

OUTPUT_DIR = "./outputs"
os.makedirs(OUTPUT_DIR, exist_ok=True)

# ------------------------------------------------------------
#  Helper functions
# ------------------------------------------------------------
def generate_channel_taps(L):
    """Exponential PDP Rayleigh fading taps with 3 dB decay per tap."""
    decay_per_tap_dB = 3.0
    r = 10 ** (-decay_per_tap_dB / 10.0)
    power = r ** np.arange(L)
    power = power / np.sum(power)
    taps = np.sqrt(power / 2) * (np.random.randn(L) + 1j * np.random.randn(L))
    return taps

def ofdm_symbol(N, Ncp):
    data = (np.random.choice([1+1j, 1-1j, -1+1j, -1-1j], N) / np.sqrt(2))
    ifft_out = np.fft.ifft(data, N) * np.sqrt(N)
    cp = ifft_out[-Ncp:]
    return np.concatenate([cp, ifft_out])

def backscatter_waveform(Nt, bit=1):
    if bit == 0:
        return -np.ones(Nt, dtype=complex)
    else:
        w = np.ones(Nt, dtype=complex)
        half = Nt // 2
        w[half:] = -1
        return w

def extract_triangle_channel(y, N, Ncp, L_max):
    start = L_max - 1
    end = Ncp - 1
    if start >= end:
        start = 0
        end = Ncp
    J = end - start + 1
    if J <= 0:
        return 0.0
    sum_abs = 0.0
    for n in range(start, end + 1):
        z_b = y[n] - y[n + N]
        z_d = y[n] + y[n + N]
        sum_abs += np.abs(z_b * z_d)
    return sum_abs / J

def mutual_info_continuous(x, y):
    mi_nats = mutual_info_regression(x.reshape(-1, 1), y, random_state=42)[0]
    return mi_nats / np.log(2)

# ------------------------------------------------------------
#  SBF algorithm (Algorithm 1), matching Eq. (37) exactly:
#  phi_m(k+1) = phi_best,m + eps_m(k),  eps_m(k) ~ U[-delta, delta]
# ------------------------------------------------------------
def sbf_algorithm(h1_I, g_I2, iterations, delta):
    M = len(h1_I)
    phi_best = np.random.uniform(0, 2 * np.pi, M)
    u_best = np.abs(np.sum(h1_I * np.exp(1j * phi_best) * g_I2))
    for k in range(iterations):
        eps = np.random.uniform(-delta, delta, M)
        phi_new = phi_best + eps
        u_new = np.abs(np.sum(h1_I * np.exp(1j * phi_new) * g_I2))
        if u_new > u_best:
            u_best = u_new
            phi_best = phi_new
    return u_best

# ------------------------------------------------------------
#  Simulation for one SNR point (three cases: no-IRS, SBF, perfect)
# ------------------------------------------------------------
def simulate_one_snr(snr_db, num_samples, N, Ncp, L_max, M, sbf_iter, delta):
    sigma_n = np.sqrt(10.0 ** (-snr_db / 10.0))
    L_h = max(1, L_max // 2)

    mi_noirs_pairs, mi_perfect_pairs, mi_sbf_pairs = [], [], []

    for _ in range(num_samples):
        h1_dir = generate_channel_taps(L_h)
        h2_dir = generate_channel_taps(L_h)
        h12_dir = generate_channel_taps(L_h)
        g1 = h1_dir[0]
        g2 = h2_dir[0]
        direct_inward = h12_dir[0]

        h1_I = (np.random.randn(M) + 1j * np.random.randn(M)) / np.sqrt(2)
        g_I2 = (np.random.randn(M) + 1j * np.random.randn(M)) / np.sqrt(2)

        ideal_irs_gain = np.sum(np.abs(h1_I) * np.abs(g_I2))
        sbf_gain = sbf_algorithm(h1_I, g_I2, sbf_iter, delta)

        G12_noirs = direct_inward
        G12_perfect = direct_inward + ideal_irs_gain
        G12_sbf = direct_inward + sbf_gain

        s_t = ofdm_symbol(N, Ncp)
        b = backscatter_waveform(Nt, bit=1)

        def get_triangle_estimate(G12):
            back_T1 = beta * (s_t * g2) * b * G12
            direct_T1 = s_t * g1
            noise1 = sigma_n * (np.random.randn(Nt) + 1j * np.random.randn(Nt)) / np.sqrt(2)
            y1 = back_T1 + direct_T1 + noise1
            u1 = extract_triangle_channel(y1, N, Ncp, L_max)

            back_T2 = beta * (s_t * g1) * b * G12
            direct_T2 = s_t * g2
            noise2 = sigma_n * (np.random.randn(Nt) + 1j * np.random.randn(Nt)) / np.sqrt(2)
            y2 = back_T2 + direct_T2 + noise2
            u2 = extract_triangle_channel(y2, N, Ncp, L_max)
            return u1, u2

        mi_noirs_pairs.append(get_triangle_estimate(G12_noirs))
        mi_perfect_pairs.append(get_triangle_estimate(G12_perfect))
        mi_sbf_pairs.append(get_triangle_estimate(G12_sbf))

    def compute_mi(pairs):
        arr1 = np.array([pt[0] for pt in pairs])
        arr2 = np.array([pt[1] for pt in pairs])
        return mutual_info_continuous(arr1, arr2)

    return (compute_mi(mi_noirs_pairs), compute_mi(mi_perfect_pairs),
            compute_mi(mi_sbf_pairs))

# ------------------------------------------------------------
#  Run simulations over SNR range
# ------------------------------------------------------------
mi_noirs_all, mi_perfect_all, mi_sbf_all = [], [], []

for snr_db in tqdm(snr_db_range, desc="Simulating"):
    mi_n, mi_p, mi_s = simulate_one_snr(
        snr_db, num_samples, N, Ncp, L_max, M, SBF_iterations, delta)
    mi_noirs_all.append(mi_n)
    mi_perfect_all.append(mi_p)
    mi_sbf_all.append(mi_s)

# ------------------------------------------------------------
#  Smooth curves (shape-preserving, avoids overshoot/dips)
# ------------------------------------------------------------
snr_smooth = np.linspace(snr_db_range[0], snr_db_range[-1], 300)

def smooth_curve(x, y, x_smooth):
    return PchipInterpolator(x, y)(x_smooth)

mi_noirs_smooth = smooth_curve(snr_db_range, mi_noirs_all, snr_smooth)
mi_perfect_smooth = smooth_curve(snr_db_range, mi_perfect_all, snr_smooth)
mi_sbf_smooth = smooth_curve(snr_db_range, mi_sbf_all, snr_smooth)

# ------------------------------------------------------------
#  Plot
# ------------------------------------------------------------
plt.rcParams.update({
    "font.family": "serif",
    "font.size": 13,
    "axes.linewidth": 1.1,
    "xtick.direction": "in",
    "ytick.direction": "in",
})

fig, ax = plt.subplots(figsize=(8, 6), dpi=300)

ax.plot(snr_smooth, mi_noirs_smooth, '-', linewidth=2, color='#e3342f')
ax.plot(snr_db_range, mi_noirs_all, 'o', linestyle='None',
        color='#e3342f', markersize=7, label='Without IRS')

ax.plot(snr_smooth, mi_sbf_smooth, '-', linewidth=2, color='#2563eb')
ax.plot(snr_db_range, mi_sbf_all, 's', linestyle='None',
        color='#2563eb', markersize=7, label='With IRS (SBF algorithm)')

ax.plot(snr_smooth, mi_perfect_smooth, '-', linewidth=2, color='#2f9e44')
ax.plot(snr_db_range, mi_perfect_all, '^', linestyle='None',
        color='#2f9e44', markersize=7, label='With IRS (perfect alignment)')

ax.set_xlabel('SNR (dB)')
ax.set_ylabel('Mutual Information (bits)')
ax.grid(True, linestyle=':', linewidth=0.7, alpha=0.6)
ax.set_axisbelow(True)

handles, labels = ax.get_legend_handles_labels()
handles = [plt.Line2D([0], [0], color=h.get_color(), marker=h.get_marker(),
                       linestyle='-', linewidth=2, markersize=7) for h in handles]
ax.legend(handles, labels, loc='upper left', frameon=True, fontsize=11)
for spine in ax.spines.values():
    spine.set_color('0.3')

plt.tight_layout()
out_path = os.path.abspath(os.path.join(OUTPUT_DIR, 'figure5_mi_comparison_sbf.png'))
try:
    plt.savefig(out_path, dpi=600, bbox_inches='tight')
    print(f"Saved: {out_path}")
except Exception as e:
    print(f"FAILED to save figure: {e}")
plt.show()

print(f"\nAt SNR = {snr_db_range[-1]} dB:")
print(f"  Without IRS:        {mi_noirs_all[-1]:.3f} bits")
print(f"  With IRS (SBF):     {mi_sbf_all[-1]:.3f} bits")
print(f"  With IRS (perfect): {mi_perfect_all[-1]:.3f} bits")

print('\n--- Full MI table ---')
for i, snr in enumerate(snr_db_range):
    print(f'SNR={snr:2d} dB | No-IRS={mi_noirs_all[i]:.3f} | '
          f'SBF={mi_sbf_all[i]:.3f} | Perfect={mi_perfect_all[i]:.3f} | '
          f'SBF-Perfect gap={mi_perfect_all[i]-mi_sbf_all[i]:.3f}')
